@using AccionSocialModels.Response
@using AccionSocialModels.DTO
@model PaginacionResponse<ListaUsuariosDTO> 
@{
    ViewData["Title"] = "Administración de Usuarios";
    Layout = "_LayoutPlantilla";
}

<div class="container m-5">
    <div class="col-md-12">
        <div class="card">
                    <div class="card-header">
                        <div class="d-flex align-items-center">
                            <h4 class="card-title">Administración de Usuarios</h4>
                            <button class="btn btn-primary btn-round ms-auto" data-bs-toggle="modal" data-bs-target="#addRowModal">
                                <i class="fa fa-plus"></i>
                                Agregar Usuario
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <!-- Filtros y búsqueda -->
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <form asp-action="AdministracionUsuarios" method="get">
                                    <div class="input-group">
                                        <input type="text" class="form-control" name="searchString" value="@ViewData["CurrentFilter"]" placeholder="Buscar usuarios...">
                                        <button class="btn btn-outline-secondary" type="submit">Buscar</button>
                                    </div>
                                </form>
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th>
                                            <a asp-action="AdministracionUsuarios" 
                                               asp-route-sortOrder="@ViewData["NameSortParam"]"
                                               asp-route-currentFilter="@ViewData["CurrentFilter"]">
                                                Usuario
                                            </a>
                                        </th>
                                        <th>Nombre Completo</th>
                                        <th>
                                            <a asp-action="AdministracionUsuarios" 
                                               asp-route-sortOrder="@ViewData["EmailSortParam"]"
                                               asp-route-currentFilter="@ViewData["CurrentFilter"]">
                                                Email
                                            </a>
                                        </th>
                                        <th>Roles</th>
                                        <th>
                                            <a asp-action="AdministracionUsuarios" 
                                               asp-route-sortOrder="@ViewData["DateSortParam"]"
                                               asp-route-currentFilter="@ViewData["CurrentFilter"]">
                                                Fecha Creación
                                            </a>
                                        </th>
                                        <th>Estado</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model?.Datos?.Any() == true)
                                    {
                                        foreach (var usuario in Model.Datos)
                                        {
                                            <tr>
                                                <td>@usuario.UserName</td>
                                                <td>@usuario.NombreCompleto</td>
                                                <td>@usuario.Email</td>
                                                <td>@string.Join(", ", usuario.Roles ?? new List<string>())</td>
                                                <td>@usuario.FechaCreacion.ToString("dd/MM/yyyy")</td>
                                                <td>
                                                    <span class="badge @(usuario.Estado ? "badge-success" : "badge-danger")">
                                                        @(usuario.Estado ? "Activo" : "Inactivo")
                                                    </span>
                                                </td>
                                                <td>
                                                    <a asp-action="UserDetails" asp-route-id="@usuario.Id"
                                                       class="btn btn-sm btn-info">Detalles</a>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="7" class="text-center">
                                                No se encontraron usuarios
                                                @if (Model != null)
                                                {
                                                    <div class="small text-muted">
                                                        Total registros: @Model.Total
                                                    </div>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            
                            <!-- Paginación -->
                            @if (Model != null && Model.Total > 0)
                            {
                                var totalPaginas = (int)Math.Ceiling((double)Model.Total / Model.TamanoPagina);
                                
                                <div class="row">
                                    <div class="col-md-12">
                                        <nav aria-label="Page navigation">
                                            <ul class="pagination justify-content-center">
                                                <li class="page-item @(Model.Pagina == 1 ? "disabled" : "")">
                                                    <a class="page-link" 
                                                       asp-action="AdministracionUsuarios"
                                                       asp-route-pagina="@(Model.Pagina - 1)"
                                                       asp-route-sortOrder="@ViewData["CurrentSort"]"
                                                       asp-route-currentFilter="@ViewData["CurrentFilter"]">
                                                        Anterior
                                                    </a>
                                                </li>
                                                
                                                @for (int i = 1; i <= totalPaginas; i++)
                                                {
                                                    <li class="page-item @(i == Model.Pagina ? "active" : "")">
                                                        <a class="page-link" 
                                                           asp-action="AdministracionUsuarios"
                                                           asp-route-pagina="@i"
                                                           asp-route-sortOrder="@ViewData["CurrentSort"]"
                                                           asp-route-currentFilter="@ViewData["CurrentFilter"]">
                                                            @i
                                                        </a>
                                                    </li>
                                                }
                                                
                                                <li class="page-item @(Model.Pagina == totalPaginas ? "disabled" : "")">
                                                    <a class="page-link" 
                                                       asp-action="AdministracionUsuarios"
                                                       asp-route-pagina="@(Model.Pagina + 1)"
                                                       asp-route-sortOrder="@ViewData["CurrentSort"]"
                                                       asp-route-currentFilter="@ViewData["CurrentFilter"]">
                                                        Siguiente
                                                    </a>
                                                </li>
                                            </ul>
                                        </nav>
                                    </div>
                                </div>
                                
                                <div class="row">
                                    <div class="col-md-12 text-center text-muted small">
                                        Mostrando página @Model.Pagina de @totalPaginas - 
                                        Registros @((Model.Pagina - 1) * Model.TamanoPagina + 1) a @Math.Min(Model.Pagina * Model.TamanoPagina, Model.Total) de @Model.Total
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
    </div>
</div>

<div class="modal fade" id="addRowModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title">
                    <span class="fw-mediumbold">Nuevo</span>
                    <span class="fw-light">Usuario</span>
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <form method="post" action="/admin/registrar-usuario">
                <div class="modal-body">
                    <p class="small">
                        Complete todos los campos para registrar un nuevo usuario
                    </p>
                    <div class="row">
                        <div class="col-sm-12">
                            <div class="form-group form-group-default">
                                <label>Nombre de Usuario</label>
                                <input name="UserName" type="text" class="form-control" placeholder="Nombre de usuario" required>
                            </div>
                        </div>
                        <div class="col-sm-12">
                            <div class="form-group form-group-default">
                                <label>Correo Electrónico</label>
                                <input name="Email" type="email" class="form-control" placeholder="Correo electrónico" required>
                            </div>
                        </div>
                        <div class="col-md-6 pe-0">
                            <div class="form-group form-group-default">
                                <label>Nombre</label>
                                <input name="Nombre" type="text" class="form-control" placeholder="Nombre" required>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group form-group-default">
                                <label>Apellidos</label>
                                <input name="Apellidos" type="text" class="form-control" placeholder="Apellidos" required>
                            </div>
                        </div>
                        <div class="col-md-6 pe-0">
                            <div class="form-group form-group-default">
                                <label>Teléfono</label>
                                <input name="PhoneNumber" type="tel" class="form-control" placeholder="Teléfono">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group form-group-default">
                                <label>Rol</label>
                                <select name="Rol" class="form-control">
                                    <option value="">Participante (por defecto)</option>
                                    <option value="Admin">Administrador</option>
                                    <option value="Participante">Participante</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6 pe-0">
                            <div class="form-group form-group-default">
                                <label>Contraseña</label>
                                <input name="Password" type="password" class="form-control" placeholder="Contraseña" required>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group form-group-default">
                                <label>Confirmar Contraseña</label>
                                <input name="ConfirmPassword" type="password" class="form-control" placeholder="Confirmar contraseña" required>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="submit" class="btn btn-primary">
                        Registrar
                    </button>
                    <button type="button" class="btn btn-danger" data-dismiss="modal">
                        Cerrar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        $(document).ready(function() {
            // Debugging - show the alert if in development
            if (window.location.hostname === "localhost") {
                $('.alert-info').removeClass('d-none');
            }

            // Handle details panel if coming from a selected user
            @if (ViewBag.ShowDetails == true)
            {
                    <text>
                    $('#userDetailsModal').modal('show');
                    </text>
            }
        });
    </script>
}