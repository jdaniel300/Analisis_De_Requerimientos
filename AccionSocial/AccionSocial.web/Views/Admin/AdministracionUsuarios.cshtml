@using AccionSocial.web.Views.ViewModel
@using AccionSocialModels.Response
@using AccionSocialModels.DTO


@{
    ViewData["Title"] = "Administración de Usuarios";
    Layout = "_LayoutPlantilla";
    @model AdminUsuariosViewModel
    
}

<div class="container m-5">
    <div class="col-md-12">
        <div class="card">
                    <div class="card-header">
                        <div class="d-flex align-items-center">
                            <h4 class="card-title">Administración de Usuarios</h4>
                            <button class="btn btn-primary btn-round ms-auto" data-bs-toggle="modal" data-bs-target="#addRowModal">
                                <i class="fa fa-plus"></i>
                                Agregar Usuario
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <!-- Filtros y búsqueda -->
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <form asp-action="AdministracionUsuarios" method="get">
                                    <div class="input-group">
                                        <input type="text" class="form-control" name="searchString" value="@ViewData["CurrentFilter"]" placeholder="Buscar usuarios...">
                                        <button class="btn btn-outline-secondary" type="submit">Buscar</button>
                                    </div>
                                </form>
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th>
                                            <a asp-action="AdministracionUsuarios" 
                                               asp-route-sortOrder="@ViewData["NameSortParam"]"
                                               asp-route-currentFilter="@ViewData["CurrentFilter"]">
                                                Usuario
                                            </a>
                                        </th>
                                        <th>Nombre Completo</th>
                                        <th>
                                            <a asp-action="AdministracionUsuarios" 
                                               asp-route-sortOrder="@ViewData["EmailSortParam"]"
                                               asp-route-currentFilter="@ViewData["CurrentFilter"]">
                                                Email
                                            </a>
                                        </th>
                                        <th>Roles</th>
                                        <th>
                                            <a asp-action="AdministracionUsuarios" 
                                               asp-route-sortOrder="@ViewData["DateSortParam"]"
                                               asp-route-currentFilter="@ViewData["CurrentFilter"]">
                                                Fecha Creación
                                            </a>
                                        </th>
                                        <th>Estado</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model?.Usuarios.Datos?.Any() == true)
                                    {
                                        foreach (var usuario in Model.Usuarios.Datos)
                                        {
                                            <tr>
                                                <td>@usuario.UserName</td>
                                                <td>@usuario.NombreCompleto</td>
                                                <td>@usuario.Email</td>
                                                <td>@string.Join(", ", usuario.Roles ?? new List<string>())</td>
                                                <td>@usuario.FechaCreacion.ToString("dd/MM/yyyy")</td>
                                                <td>
                                                    <span class="badge @(usuario.Estado ? "badge-success" : "badge-danger")">
                                                        @(usuario.Estado ? "Activo" : "Inactivo")
                                                    </span>
                                                </td>
                                                <td>
                                                    <a asp-action="UserDetails" asp-route-id="@usuario.Id"
                                                       class="btn btn-sm btn-info">Detalles</a>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="7" class="text-center">
                                                No se encontraron usuarios
                                                @if (Model != null)
                                                {
                                                    <div class="small text-muted">
                                                        Total registros: @Model.Usuarios.Total
                                                    </div>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            
                            <!-- Paginación -->
                            @if (Model != null && Model.Usuarios.Total > 0)
                            {
                                var totalPaginas = (int)Math.Ceiling((double)Model.Usuarios.Total / Model.Usuarios.TamanoPagina);
                                
                                <div class="row">
                                    <div class="col-md-12">
                                        <nav aria-label="Page navigation">
                                            <ul class="pagination justify-content-center">
                                                <li class="page-item @(Model.Usuarios.Pagina == 1 ? "disabled" : "")">
                                                    <a class="page-link" 
                                                       asp-action="AdministracionUsuarios"
                                                       asp-route-pagina="@(Model.Usuarios.Pagina - 1)"
                                                       asp-route-sortOrder="@ViewData["CurrentSort"]"
                                                       asp-route-currentFilter="@ViewData["CurrentFilter"]">
                                                        Anterior
                                                    </a>
                                                </li>
                                                
                                                @for (int i = 1; i <= totalPaginas; i++)
                                                {
                                                    <li class="page-item @(i == Model.Usuarios.Pagina ? "active" : "")">
                                                        <a class="page-link" 
                                                           asp-action="AdministracionUsuarios"
                                                           asp-route-pagina="@i"
                                                           asp-route-sortOrder="@ViewData["CurrentSort"]"
                                                           asp-route-currentFilter="@ViewData["CurrentFilter"]">
                                                            @i
                                                        </a>
                                                    </li>
                                                }
                                                
                                                <li class="page-item @(Model.Usuarios.Pagina == totalPaginas ? "disabled" : "")">
                                                    <a class="page-link" 
                                                       asp-action="AdministracionUsuarios"
                                                       asp-route-pagina="@(Model.Usuarios.Pagina + 1)"
                                                       asp-route-sortOrder="@ViewData["CurrentSort"]"
                                                       asp-route-currentFilter="@ViewData["CurrentFilter"]">
                                                        Siguiente
                                                    </a>
                                                </li>
                                            </ul>
                                        </nav>
                                    </div>
                                </div>
                                
                                <div class="row">
                                    <div class="col-md-12 text-center text-muted small">
                                        Mostrando página @Model.Usuarios.Pagina de @totalPaginas - 
                                        Registros @((Model.Usuarios.Pagina - 1) * Model.Usuarios.TamanoPagina + 1) a @Math.Min(Model.Usuarios.Pagina * Model.Usuarios.TamanoPagina, Model.Usuarios.Total) de @Model.Usuarios.Total
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
    </div>
</div>

<div class="modal fade" id="addRowModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title">
                    <span class="fw-mediumbold">Nuevo</span>
                    <span class="fw-light">Usuario</span>
                </h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <form id="registerUserForm" method="post" asp-controller="Admin" asp-action="RegistrarUsuario">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div id="generalErrorsContainer" class="alert alert-danger d-none"></div>
                    
                    <p class="small">
                        Complete todos los campos para registrar un nuevo usuario
                    </p>
                    <div class="row">
                        <div class="col-sm-12">
                            <div class="form-group form-group-default">
                                <label>Nombre de Usuario</label>
                                <input asp-for="RegistroModel.UserName" id="UserName" name="UserName" type="text" class="form-control" placeholder="Nombre de usuario">
                                <span asp-validation-for="RegistroModel.UserName" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-sm-12">
                            <div class="form-group form-group-default">
                                <label>Correo Electrónico</label>
                                <input asp-for="RegistroModel.Email" id="Email" name="Email" type="email" class="form-control" placeholder="Correo electrónico">
                                <span asp-validation-for="RegistroModel.Email" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6 pe-0">
                            <div class="form-group form-group-default">
                                <label>Nombre</label>
                                <input asp-for="RegistroModel.Nombre" id="Nombre" name="Nombre" type="text" class="form-control" placeholder="Nombre">
                                <span asp-validation-for="RegistroModel.Nombre" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group form-group-default">
                                <label>Apellidos</label>
                                <input asp-for="RegistroModel.Apellidos" id="Apellidos" name="Apellidos" type="text" class="form-control" placeholder="Apellidos">
                                <span asp-validation-for="RegistroModel.Apellidos" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6 pe-0">
                            <div class="form-group form-group-default">
                                <label>Teléfono</label>
                                <input asp-for="RegistroModel.PhoneNumber" id="PhoneNumber" name="PhoneNumber" type="tel" class="form-control" placeholder="Teléfono">
                                <span asp-validation-for="RegistroModel.PhoneNumber" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group form-group-default">
                                <label>Rol</label>
                                <select asp-for="RegistroModel.Rol" id="Rol" name="Rol" class="form-control">
                                    <option value="">Participante (por defecto)</option>
                                    @if (ViewBag.Roles != null)
                                    {
                                        foreach (var rol in ViewBag.Roles)
                                        {
                                            <option value="@rol.Name">@rol.Name</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="RegistroModel.Rol" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6 pe-0">
                            <div class="form-group form-group-default">
                                <label>Contraseña</label>
                                <input asp-for="RegistroModel.Password" id="Password" name="Password" type="password" class="form-control" placeholder="Contraseña">
                                <span asp-validation-for="RegistroModel.Password" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group form-group-default">
                                <label>Confirmar Contraseña</label>
                                <input asp-for="RegistroModel.ConfirmPassword" id="ConfirmPassword" name="ConfirmPassword" type="password" class="form-control" placeholder="Confirmar contraseña">
                                <span asp-validation-for="RegistroModel.ConfirmPassword" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="submit" class="btn btn-primary">
                        Registrar
                    </button>
                    <button type="button" class="btn btn-danger" data-bs-dismiss="modal">
                        Cerrar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Función para mostrar errores
            function showErrors(errors) {
                if (!errors || errors.length === 0) return;
                
                var errorContainer = $('#generalErrorsContainer');
                errorContainer.empty().removeClass('d-none');
                
                // Manejar tanto arrays como objetos de errores
                if (Array.isArray(errors)) {
                    errors.slice(0, 5).forEach(function(error) {
                        errorContainer.append('<div class="text-danger">' + error + '</div>');
                    });
                } else if (typeof errors === 'object') {
                    // Manejar errores en formato { campo: ["error1", "error2"] }
                    for (var field in errors) {
                        if (errors.hasOwnProperty(field)) {
                            errors[field].forEach(function(error) {
                                errorContainer.append('<div class="text-danger">' + error + '</div>');
                            });
                        }
                    }
                }
            }

            // Configuración del formulario
            $('#registerUserForm').on('submit', function(e) {
                e.preventDefault();
                
                // Limpiar errores previos
                $('.text-danger').text('');
                $('#generalErrorsContainer').addClass('d-none').empty();
            
                var submitBtn = $(this).find('button[type="submit"]');
                var modal = $('#addRowModal');
                submitBtn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Procesando...');
            
                // Validación básica del lado del cliente
                var errors = [];
                if (!$('#UserName').val()) errors.push("El nombre de usuario es requerido");
                if (!$('#Email').val()) errors.push("El correo electrónico es requerido");
                if (!$('#Nombre').val()) errors.push("El nombre es requerido");
                if (!$('#Apellidos').val()) errors.push("Los apellidos son requeridos");
                if (!$('#PhoneNumber').val()) errors.push("El teléfono es requerido");
                if (!$('#Password').val()) errors.push("La contraseña es requerida");
                if (!$('#ConfirmPassword').val()) errors.push("La confirmación de contraseña es requerida");
                if ($('#Password').val() !== $('#ConfirmPassword').val()) errors.push("Las contraseñas no coinciden");
            
                if (errors.length > 0) {
                    showErrors(errors);
                    submitBtn.prop('disabled', false).text('Registrar');
                    return;
                }
            
                // Enviar datos al servidor
                $.ajax({
                    url: $(this).attr('action'),
                    type: 'POST',
                    data: $(this).serialize(),
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val(),
                        'Accept': 'application/json'
                    },
                    success: function(response) {
                        console.log("Respuesta exitosa del servidor:", response);
                        
                        if (response && response.success) {
                            toastr.success(response.message || 'Usuario registrado correctamente');
                            
                            // Configurar el evento de cierre ANTES de cerrar el modal
                            modal.one('hidden.bs.modal', function() {
                                // Recargar la página después de cerrar el modal
                                setTimeout(function() {
                                    location.reload();
                                }, 500);
                            });
                            
                            // Cerrar el modal
                            modal.modal('hide');
                        } else {
                            // Manejar respuesta con error pero código 200
                            var errorMsg = response?.message || 'Error al registrar usuario';
                            toastr.error(errorMsg);
                            
                            if (response?.errors) {
                                showErrors(response.errors.General || response.errors);
                            }
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error("Error en la petición AJAX:", xhr.responseText, status, error);
                        
                        try {
                            var errorResponse = JSON.parse(xhr.responseText);
                            var errorMsg = errorResponse.message || 'Error en el registro';
                            
                            if (errorResponse.errors && errorResponse.errors.General) {
                                showErrors(errorResponse.errors.General);
                            } else if (errorResponse.errors) {
                                showErrors(errorResponse.errors);
                            } else {
                                showErrors([errorMsg]);
                            }
                            
                            toastr.error(errorMsg);
                        } catch (e) {
                            var errorMsg = xhr.responseText || "Error desconocido al procesar la solicitud";
                            toastr.error(errorMsg);
                            showErrors([errorMsg]);
                        }
                    },
                    complete: function() {
                        submitBtn.prop('disabled', false).text('Registrar');
                    }
                });
            });
            
            // Limpiar el modal cuando se cierre
            $('#addRowModal').on('hidden.bs.modal', function() {
                $('#registerUserForm')[0].reset();
                $('.text-danger').text('');
                $('#generalErrorsContainer').addClass('d-none').empty();
            });

            // Manejo de botones de cierre del modal
            $(document).on('click', '[data-dismiss="modal"], .close-modal', function() {
                $('#addRowModal').modal('hide');
            });
        });
    </script>
}