@using AccionSocial.web.Views.ViewModel
@using AccionSocialModels.Response
@using AccionSocialModels.DTO


@{
    ViewData["Title"] = "Administración de Usuarios";
    Layout = "_LayoutPlantilla";
    @model AdminUsuariosViewModel
    
}

<div class="container m-5">
    <div class="col-md-12">
        <div class="card">
                    <div class="card-header">
                        <div class="d-flex align-items-center">
                            <h4 class="card-title">Administración de Usuarios</h4>
                            <button class="btn btn-primary btn-round ms-auto" data-bs-toggle="modal" data-bs-target="#addRowModal">
                                <i class="fa fa-plus"></i>
                                Agregar Usuario
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <!-- Filtros y búsqueda -->
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <form asp-action="AdministracionUsuarios" method="get">
                                    <div class="input-group">
                                        <input type="text" class="form-control" name="searchString" value="@ViewData["CurrentFilter"]" placeholder="Buscar usuarios...">
                                        <button class="btn btn-outline-secondary" type="submit">Buscar</button>
                                    </div>
                                </form>
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th>
                                            <a asp-action="AdministracionUsuarios" 
                                               asp-route-sortOrder="@ViewData["NameSortParam"]"
                                               asp-route-currentFilter="@ViewData["CurrentFilter"]">
                                                Usuario
                                            </a>
                                        </th>
                                        <th>Nombre Completo</th>
                                        <th>
                                            <a asp-action="AdministracionUsuarios" 
                                               asp-route-sortOrder="@ViewData["EmailSortParam"]"
                                               asp-route-currentFilter="@ViewData["CurrentFilter"]">
                                                Email
                                            </a>
                                        </th>
                                        <th>Roles</th>
                                        <th>
                                            <a asp-action="AdministracionUsuarios" 
                                               asp-route-sortOrder="@ViewData["DateSortParam"]"
                                               asp-route-currentFilter="@ViewData["CurrentFilter"]">
                                                Fecha Creación
                                            </a>
                                        </th>
                                        <th>Estado</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model?.Usuarios.Datos?.Any() == true)
                                    {
                                        foreach (var usuario in Model.Usuarios.Datos)
                                        {
                                            <tr>
                                                <td>@usuario.UserName</td>
                                                <td>@usuario.NombreCompleto</td>
                                                <td>@usuario.Email</td>
                                                <td>@string.Join(", ", usuario.Roles ?? new List<string>())</td>
                                                <td>@usuario.FechaCreacion.ToString("dd/MM/yyyy")</td>
                                                <td>
                                                    <span class="badge @(usuario.Estado ? "badge-success" : "badge-danger")">
                                                        @(usuario.Estado ? "Activo" : "Inactivo")
                                                    </span>
                                                </td>
                                                <td>
                                                    <a asp-action="UserDetails" asp-route-id="@usuario.Id"
                                                       class="btn btn-sm btn-info">Detalles</a>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="7" class="text-center">
                                                No se encontraron usuarios
                                                @if (Model != null)
                                                {
                                                    <div class="small text-muted">
                                                        Total registros: @Model.Usuarios.Total
                                                    </div>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            
                            <!-- Paginación -->
                            @if (Model != null && Model.Usuarios.Total > 0)
                            {
                                var totalPaginas = (int)Math.Ceiling((double)Model.Usuarios.Total / Model.Usuarios.TamanoPagina);
                                
                                <div class="row">
                                    <div class="col-md-12">
                                        <nav aria-label="Page navigation">
                                            <ul class="pagination justify-content-center">
                                                <li class="page-item @(Model.Usuarios.Pagina == 1 ? "disabled" : "")">
                                                    <a class="page-link" 
                                                       asp-action="AdministracionUsuarios"
                                                       asp-route-pagina="@(Model.Usuarios.Pagina - 1)"
                                                       asp-route-sortOrder="@ViewData["CurrentSort"]"
                                                       asp-route-currentFilter="@ViewData["CurrentFilter"]">
                                                        Anterior
                                                    </a>
                                                </li>
                                                
                                                @for (int i = 1; i <= totalPaginas; i++)
                                                {
                                                    <li class="page-item @(i == Model.Usuarios.Pagina ? "active" : "")">
                                                        <a class="page-link" 
                                                           asp-action="AdministracionUsuarios"
                                                           asp-route-pagina="@i"
                                                           asp-route-sortOrder="@ViewData["CurrentSort"]"
                                                           asp-route-currentFilter="@ViewData["CurrentFilter"]">
                                                            @i
                                                        </a>
                                                    </li>
                                                }
                                                
                                                <li class="page-item @(Model.Usuarios.Pagina == totalPaginas ? "disabled" : "")">
                                                    <a class="page-link" 
                                                       asp-action="AdministracionUsuarios"
                                                       asp-route-pagina="@(Model.Usuarios.Pagina + 1)"
                                                       asp-route-sortOrder="@ViewData["CurrentSort"]"
                                                       asp-route-currentFilter="@ViewData["CurrentFilter"]">
                                                        Siguiente
                                                    </a>
                                                </li>
                                            </ul>
                                        </nav>
                                    </div>
                                </div>
                                
                                <div class="row">
                                    <div class="col-md-12 text-center text-muted small">
                                        Mostrando página @Model.Usuarios.Pagina de @totalPaginas - 
                                        Registros @((Model.Usuarios.Pagina - 1) * Model.Usuarios.TamanoPagina + 1) a @Math.Min(Model.Usuarios.Pagina * Model.Usuarios.TamanoPagina, Model.Usuarios.Total) de @Model.Usuarios.Total
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
    </div>
</div>

<div class="modal fade" id="addRowModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title">
                    <span class="fw-mediumbold">Nuevo</span>
                    <span class="fw-light">Usuario</span>
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <form method="post" asp-controller="Admin" asp-action="RegistrarUsuario">
                <div class="modal-body">
                     <div id="generalErrorsContainer"></div>
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">
                            <ul>
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <li>@error.ErrorMessage</li>
                                }
                            </ul>
                        </div>
                    }
                    
                    <p class="small">
                        Complete todos los campos para registrar un nuevo usuario
                    </p>
                    <div class="row">
                        <div class="col-sm-12">
                            <div class="form-group form-group-default">
                                <label>Nombre de Usuario</label>
                                <input asp-for="RegistroModel.UserName" type="text" class="form-control" placeholder="Nombre de usuario" required>
                                <span asp-validation-for="RegistroModel.UserName" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-sm-12">
                            <div class="form-group form-group-default">
                                <label>Correo Electrónico</label>
                                <input asp-for="RegistroModel.Email" type="email" class="form-control" placeholder="Correo electrónico" required>
                                <span asp-validation-for="RegistroModel.Email" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6 pe-0">
                            <div class="form-group form-group-default">
                                <label>Nombre</label>
                                <input asp-for="RegistroModel.Nombre" type="text" class="form-control" placeholder="Nombre" required>
                                <span asp-validation-for="RegistroModel.Nombre" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group form-group-default">
                                <label>Apellidos</label>
                                <input asp-for="RegistroModel.Apellidos" type="text" class="form-control" placeholder="Apellidos" required>
                                <span asp-validation-for="RegistroModel.Apellidos" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6 pe-0">
                            <div class="form-group form-group-default">
                                <label>Teléfono</label>
                                <input asp-for="RegistroModel.PhoneNumber" type="tel" class="form-control" placeholder="Teléfono">
                                <span asp-validation-for="RegistroModel.PhoneNumber" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group form-group-default">
                                <label>Rol</label>
                                <select asp-for="RegistroModel.Rol" class="form-control" id="selectRol">
                                    <option value="">Participante (por defecto)</option>
                                    @if (ViewBag.Roles != null)
                                    {
                                        foreach (var rol in ViewBag.Roles)
                                        {
                                            <option value="@rol.Name">@rol.Name</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="RegistroModel.Rol" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6 pe-0">
                            <div class="form-group form-group-default">
                                <label>Contraseña</label>
                                <input asp-for="RegistroModel.Password" type="password" class="form-control" placeholder="Contraseña" required>
                                <span asp-validation-for="RegistroModel.Password" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group form-group-default">
                                <label>Confirmar Contraseña</label>
                                <input asp-for="RegistroModel.ConfirmPassword" type="password" class="form-control" placeholder="Confirmar contraseña" required>
                                <span asp-validation-for="RegistroModel.ConfirmPassword" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="submit" class="btn btn-primary">
                        Registrar
                    </button>
                    <button type="button" class="btn btn-danger" data-dismiss="modal">
                        Cerrar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Debugging - show the alert if in development
            if (window.location.hostname === "localhost") {
                $('.alert-info').removeClass('d-none');
            }

            // Handle details panel if coming from a selected user
            @if (ViewBag.ShowDetails == true)
            {
                    <text>
                    $('#userDetailsModal').modal('show');
                    </text>
            }
        });

        $('#addRowModal form').on('submit', function(e) {
        e.preventDefault();
        
        var form = $(this);
        var url = form.attr('action');
        var formData = form.serialize();
        
        $.ajax({
            type: "POST",
            url: url,
            data: formData,
            dataType: "json", // Esperamos una respuesta JSON
            success: function(response) {
                if (response.success) {
                    // Cierra el modal y recarga la página o actualiza la tabla
                    $('#addRowModal').modal('hide');
                    // Opción 1: Recargar la página
                    location.reload();
                    // Opción 2: Actualizar solo la tabla de usuarios
                    // refreshUserTable();
                } else {
                    // Muestra los errores en el modal
                    showErrorsInModal(response.errors);
                }
            },
            error: function(xhr, status, error) {
                console.error(error);
                // Muestra un mensaje genérico de error
                showErrorsInModal(["Ocurrió un error al procesar la solicitud"]);
            }
            });
        });
        
        function showErrorsInModal(errors) {
            // 1. Limpia errores anteriores
            $('.text-danger').text(''); // Limpia mensajes de campo específicos
            $('.alert-danger').remove(); // Elimina alertas generales
            
            // 2. Agrupa errores por campo
            var fieldErrors = {
                // Mapea nombres de errores a campos del formulario
                "correo electrónico": "RegistroModel.Email",
                "nombre": "RegistroModel.Nombre",
                "contraseña": "RegistroModel.Password",
                "nombre de usuario": "RegistroModel.UserName",
                "apellidos": "RegistroModel.Apellidos",
                "phonenumber": "RegistroModel.PhoneNumber",
                "confirmación de contraseña": "RegistroModel.ConfirmPassword"
            };
            
            var generalErrors = [];
            
            // 3. Procesa cada error
            errors.forEach(function(error) {
                var matched = false;
                
                // Busca si el error corresponde a un campo específico
                for (var key in fieldErrors) {
                    if (error.toLowerCase().includes(key)) {
                        var fieldName = fieldErrors[key];
                        var $field = $('[name="' + fieldName + '"]');
                        if ($field.length) {
                            $field.siblings('.text-danger').text(error);
                            matched = true;
                            break;
                        }
                    }
                }
                
                // Si no coincide con ningún campo, agrega a errores generales
                if (!matched) {
                    generalErrors.push(error);
                }
            });
            
            // 4. Muestra errores generales si existen
            if (generalErrors.length > 0) {
                var alertHtml = '<div class="alert alert-danger"><ul>';
                
                generalErrors.forEach(function(error) {
                    alertHtml += '<li>' + error + '</li>';
                });
                
                alertHtml += '</ul></div>';
                
                // Inserta la alerta después del título del modal
                $('.modal-title').after(alertHtml);
            }
        }
        
        // Limpia los errores cuando se cierra el modal
        $('#addRowModal').on('hidden.bs.modal', function () {
            $('.text-danger').text('');
            $('.alert-danger').remove();
        });

    </script>
}