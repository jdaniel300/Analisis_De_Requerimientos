@{
    ViewData["Title"] = "Registrar Taller";
    Layout = "_LayoutPlantilla";
}

<div class="container mt-4">
    <div class="page-inner">
        <div class="row">
            <div class="col-md-12 d-flex justify-content-between align-items-center mb-4">
                <h3 class="fw-bold">Registrar Taller</h3>
                <a href="https://docs.google.com/forms/d/e/1FAIpQLSdveYeJYieakBF_F7wtHnPjBiG0dl0OPWlqE4eWzIsIuOjAlw/viewform" target="_blank" class="btn btn-outline-primary">
                    Llenar encuesta de talleres anteriores
                </a>
            </div>
        </div>

        <!-- Filtro por días -->
        <div class="row mb-4">
            <div class="col d-flex justify-content-center">
                <div class="btn-group" role="group">
                    <button type="button" class="btn btn-outline-secondary" onclick="filtrarPorDia('lunes')">Lunes</button>
                    <button type="button" class="btn btn-outline-secondary" onclick="filtrarPorDia('martes')">Martes</button>
                    <button type="button" class="btn btn-outline-secondary" onclick="filtrarPorDia('miercoles')">Miércoles</button>
                    <button type="button" class="btn btn-outline-secondary" onclick="filtrarPorDia('jueves')">Jueves</button>
                    <button type="button" class="btn btn-outline-secondary" onclick="filtrarPorDia('viernes')">Viernes</button>
                </div>
            </div>
        </div>

        <!-- Tarjetas de talleres -->
        <div id="contenedor-talleres" class="row">
            <!-- Taller lunes -->
            <div class="col-sm-6 col-lg-4 taller-card" data-dia="lunes">
                <div class="card card-stats card-round" onclick="mostrarDetalleTaller('Taller de Liderazgo', '10:00 AM', 18)">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-4 d-flex align-items-center justify-content-center">
                                <div class="icon-big text-center icon-primary bubble-shadow-small">
                                    <i class="fas fa-chalkboard-teacher"></i>
                                </div>
                            </div>
                            <div class="col-8">
                                <div class="numbers">
                                    <p class="card-category">Taller de Liderazgo</p>
                                    <h4 class="card-title">10:00 AM</h4>
                                    <p class="card-category">Participantes: 18</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Taller martes -->
            <div class="col-sm-6 col-lg-4 taller-card" data-dia="martes">
                <div class="card card-stats card-round" onclick="mostrarDetalleTaller('Taller de Comunicación', '2:00 PM', 25)">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-4 d-flex align-items-center justify-content-center">
                                <div class="icon-big text-center icon-info bubble-shadow-small">
                                    <i class="fas fa-comments"></i>
                                </div>
                            </div>
                            <div class="col-8">
                                <div class="numbers">
                                    <p class="card-category">Taller de Comunicación</p>
                                    <h4 class="card-title">2:00 PM</h4>
                                    <p class="card-category">Participantes: 25</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Detalle del taller -->
        <div id="detalle-taller" class="card mt-5" style="display: none;">
            <div class="card-header">
                <h4 class="fw-bold" id="detalle-nombre">Detalle del Taller</h4>
            </div>
            <div class="card-body">
                <p><strong>Hora:</strong> <span id="detalle-hora"></span></p>
                <p><strong>Participantes:</strong> <span id="detalle-participantes"></span></p>
                <div class="mt-3">
                    <button class="btn btn-primary me-2" onclick="matricular()">✅ Matricular</button>
                    <button class="btn btn-danger" onclick="desmatricular()">❌ Desmatricular</button>
                </div>
                <div class="alert alert-success mt-3" id="alerta-matricula" style="display: none;">
                    Taller matriculado correctamente.
                </div>
                <div class="alert alert-warning mt-3" id="alerta-desmatricula" style="display: none;">
                    Taller desmatriculado correctamente.
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function filtrarPorDia(dia) {
        const cards = document.querySelectorAll('.taller-card');
        cards.forEach(c => c.style.display = c.dataset.dia === dia ? 'block' : 'none');
        document.getElementById('detalle-taller').style.display = 'none';
    }

    function mostrarDetalleTaller(nombre, hora, participantes) {
        document.getElementById('detalle-nombre').innerText = nombre;
        document.getElementById('detalle-hora').innerText = hora;
        document.getElementById('detalle-participantes').innerText = participantes;
        document.getElementById('detalle-taller').style.display = 'block';
        document.getElementById('alerta-matricula').style.display = 'none';
        document.getElementById('alerta-desmatricula').style.display = 'none';
    }

    function matricular() {
        document.getElementById('alerta-matricula').style.display = 'block';
        document.getElementById('alerta-desmatricula').style.display = 'none';
    }

    function desmatricular() {
        document.getElementById('alerta-matricula').style.display = 'none';
        document.getElementById('alerta-desmatricula').style.display = 'block';
    }
</script>
