@{
    ViewData["Title"] = "Gestión de Códigos QR";
    Layout = "_LayoutPlantilla";
}

<div class="container mt-4">
    <div class="page-inner">
        <h3 class="fw-bold mb-4">Gestión de Códigos QR</h3>

        <!-- Generar QR para sesión de taller -->
        <div class="card mb-4">
            <div class="card-header"><strong>QR para sesión de taller</strong></div>
            <div class="card-body">
                <p>Escanea este QR para registrar asistencia automática a la sesión.</p>
                @{
                    var idTaller = 123; // Reemplazar con valor real dinámico
                    var participanteEjemplo = "456"; // Simulación de participante
                    var urlAsistencia = Url.Action("RegistrarAsistencia", "Home", new
                    {
                        idParticipante = participanteEjemplo,
                        idTaller = idTaller
                    }, protocol: Context.Request.Scheme);

                    var qrUrl = $"https://api.qrserver.com/v1/create-qr-code/?data={Uri.EscapeDataString(urlAsistencia)}&size=200x200";
                }
                <img src="@qrUrl" alt="QR Taller" />
                <p><strong>URL:</strong> <a href="@urlAsistencia" target="_blank">@urlAsistencia</a></p>
            </div>
        </div>

        <!-- Generar carnet QR para participante -->
        <div class="card mb-4">
            <div class="card-header"><strong>Carnet QR para participante</strong></div>
            <div class="card-body">
                @{
                    var participanteId = "456";
                    var urlCarnet = Url.Action("RegistrarAsistencia", "Home", new
                    {
                        idParticipante = participanteId,
                        idTaller = idTaller
                    }, protocol: Context.Request.Scheme);

                    var qrCarnetUrl = $"https://api.qrserver.com/v1/create-qr-code/?data={Uri.EscapeDataString(urlCarnet)}&size=150x150";
                }
                <img src="@qrCarnetUrl" alt="QR Carnet" />
                <p><strong>Nombre:</strong> Ana Gómez</p>
                <p><strong>ID:</strong> @participanteId</p>
                <p><strong>URL:</strong> <a href="@urlCarnet" target="_blank">@urlCarnet</a></p>
            </div>
        </div>

        <!-- Escaneo manual (encargado) -->
        <div class="card mb-5">
            <div class="card-header"><strong>Escanear QR manualmente (encargado)</strong></div>
            <div class="card-body">
                <div id="qr-reader" style="width:300px"></div>
                <div id="qr-result" class="mt-2 text-success fw-bold"></div>
            </div>
        </div>
    </div>
</div>

<script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>
<script>
    function onScanSuccess(decodedText) {
        document.getElementById('qr-result').innerText = "Escaneado: " + decodedText;

        // Enviar al backend
        fetch(decodedText)
            .then(response => {
                if (response.ok) {
                    alert("✅ Asistencia registrada correctamente.");
                } else {
                    alert("❌ Error al registrar asistencia.");
                }
            })
            .catch(() => alert("⚠️ Error de red."));
    }

    const qrScanner = new Html5Qrcode("qr-reader");
    qrScanner.start({ facingMode: "environment" }, { fps: 10, qrbox: 250 }, onScanSuccess);
</script>
