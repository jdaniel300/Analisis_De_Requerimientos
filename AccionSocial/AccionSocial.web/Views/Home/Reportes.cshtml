@{
    ViewData["Title"] = "Reportes Generales";
    Layout = "_LayoutPlantilla";
}

<div class="container mt-4">
    <div class="page-inner">
        <div class="row mb-4">
            <div class="col-md-12 d-flex justify-content-between align-items-center">
                <h3 class="fw-bold">Reportes Generales</h3>
            </div>
        </div>

        <!-- Panel administrador: Reportes Consolidados (Power BI) -->
        <div class="card mb-4">
            <div class="card-header">
                <h4 class="card-title">Consolidado de Talleres</h4>
                <p class="text-muted mb-0">Visualización generada con Power BI API (asistencia, ingresos, feedback)</p>
            </div>
            <div class="card-body">
                <div class="ratio ratio-16x9">
                    <!-- REEMPLAZAR con embed de Power BI -->
                    <iframe src="https://app.powerbi.com/view?r=TU_EMBED_URL_ADMIN" frameborder="0" allowfullscreen></iframe>
                </div>
            </div>
        </div>

        <!-- Panel encargado: Reportes financieros -->
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h4 class="card-title mb-0">Reporte Financiero por Taller</h4>
                <div>
                    <button class="btn btn-outline-success me-2" onclick="exportarPDF()">📄 Exportar PDF</button>
                    <button class="btn btn-outline-primary" onclick="exportarExcel()">📊 Exportar Excel</button>
                </div>
            </div>
            <div class="card-body">
                <form id="form-filtros" class="row mb-4">
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Taller</label>
                        <select class="form-select" id="selectTaller">
                            <option selected disabled>Seleccione un taller</option>
                            <option value="Microfinanzas">Microfinanzas</option>
                            <option value="Costurería">Costurería</option>
                            <option value="Ejercicios">Ejercicios</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Fecha</label>
                        <input type="date" class="form-control" id="fechaFiltro" />
                    </div>
                </form>

                <div class="table-responsive">
                    <table class="table table-bordered" id="tablaFinanciera">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Concepto</th>
                                <th>Ingreso</th>
                                <th>Gasto</th>
                                <th>Saldo</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Estos datos deben venir desde base de datos -->
                            <tr>
                                <td>2025-07-01</td>
                                <td>Cuotas de participación</td>
                                <td>₡10,000</td>
                                <td>-</td>
                                <td>₡10,000</td>
                            </tr>
                            <tr>
                                <td>2025-07-03</td>
                                <td>Compra de materiales</td>
                                <td>-</td>
                                <td>₡2,500</td>
                                <td>₡7,500</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Exportación PDF y Excel -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>

<script>
    async function exportarPDF() {
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF();
        doc.text("Reporte Financiero por Taller", 20, 20);

        let filaY = 30;
        document.querySelectorAll("#tablaFinanciera tbody tr").forEach((row, index) => {
            const celdas = row.querySelectorAll("td");
            let filaTexto = Array.from(celdas).map(c => c.innerText).join(" | ");
            doc.text(filaTexto, 20, filaY);
            filaY += 10;
        });

        doc.save("reporte_financiero.pdf");
    }

    function exportarExcel() {
        const tabla = document.getElementById("tablaFinanciera");
        const wb = XLSX.utils.table_to_book(tabla, { sheet: "Reporte" });
        XLSX.writeFile(wb, "reporte_financiero.xlsx");
    }
</script>
