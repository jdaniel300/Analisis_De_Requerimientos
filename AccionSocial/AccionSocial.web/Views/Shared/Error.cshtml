@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
    Layout = "_LayoutPlantilla";
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            Swal.fire({
                icon: 'error',
                title: '¡Algo salió mal!',
                html: `
                    <p>Ocurrió un error mientras se procesaba tu solicitud.</p>
                    ${'@Model.ShowRequestId'.ToLower() == "true" ? `<p><strong>ID de solicitud:</strong> <code>@Model.RequestId</code></p>` : ''}
                    <hr />
                    <p style="font-size: 0.9em; color: gray;">
                        Si estás en desarrollo, habilita el entorno <strong>Development</strong> para ver más detalles del error.
                    </p>
                `,
                confirmButtonText: 'Aceptar',
                confirmButtonColor: '#406e7b'
            });
        });
    </script>
}
