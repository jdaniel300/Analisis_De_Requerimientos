@model AccionSocialModels.DTO.LoginDTO
@{
    ViewData["Title"] = "Inicio de Sesion";
    Layout = "_LayoutPlantilla";
 
}
<style>
    .card, .card * {
        color: #406e7b;
    }

    .form-control {
        border-radius: 50px !important;
    }

    .btn-custom {
        background-color: #406e7b;
        color: white;
        border-radius: 50px;
        border: none;
    }

        .btn-custom:hover {
            background-color: #2e505a;
            color: white;
        }

    .form-check-input {
        border-radius: 50%;
    }
</style>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="text-center flex-grow-1 mb-0">Iniciar Sesión</h3>
                <img src="~/Logo.jfif" alt="Logo" style="height: 50px;" />
            </div>
            <div class="card-body">
                <form asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="form-group mb-3">
                        <label asp-for="UsernameOrEmail" class="control-label"></label>
                        <input asp-for="UsernameOrEmail" class="form-control" placeholder="Ingrese su usuario o correo" />
                        <span asp-validation-for="UsernameOrEmail" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Password" class="control-label"></label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="Ingrese su contraseña" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="form-group form-check mb-3">
                        <input class="form-check-input" asp-for="RememberMe" />
                        <label class="form-check-label" asp-for="RememberMe"></label>
                    </div>

                    <div class="form-group">
                        <button type="submit" class="btn btn-custom w-100">Iniciar Sesión</button>
                    </div>

                    <div class="login-link mt-3 text-center">
                        ¿No tienes una cuenta? <a asp-action="Register">Regístrate aquí</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('loginForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const form = e.target;
            const button = form.querySelector('button[type="submit"]');
            const errorElement = document.getElementById('loginError');
            const username = document.getElementById('username').value;

            // Reset error and UI state
            errorElement.style.display = 'none';
            errorElement.textContent = '';
            const originalButtonText = button.innerHTML;

            // Update UI for loading state
            button.disabled = true;
            button.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Verificando...';

            try {
                const response = await fetch(form.action, {
                    method: 'POST',
                    body: new FormData(form),
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': form.querySelector('input[name="__RequestVerificationToken"]').value,
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });

                if (!response.ok) {
                    let errorMessage = 'Error en la autenticación';
                    let disableFormDuration = 0;

                    // Handle different error statuses
                    if (response.status === 429) {
                        errorMessage = 'Demasiados intentos. Por favor espere 5 minutos.';
                        disableFormDuration = 300000; // 5 minutes
                    } else if (response.status === 401) {
                        // Get remaining attempts from response headers if available
                        const remainingAttempts = response.headers.get('X-Remaining-Attempts');
                        if (remainingAttempts && remainingAttempts > 0) {
                            errorMessage = `Credenciales inválidas. Le quedan ${remainingAttempts} intentos.`;
                        } else {
                            errorMessage = 'Credenciales inválidas';
                        }
                    } else if (response.status >= 500) {
                        errorMessage = 'Error del servidor. Por favor intente más tarde.';
                    }

                    // Try to get error details from response
                    try {
                        const errorData = await response.json();
                        if (errorData.message) {
                            errorMessage = errorData.message;
                        }
                        if (errorData.remainingAttempts) {
                            errorMessage += ` (Intentos restantes: ${errorData.remainingAttempts})`;
                        }
                    } catch (e) {
                        console.log('Could not parse error response');
                    }

                    if (disableFormDuration > 0) {
                        disableForm(form, disableFormDuration);
                    }

                    throw new Error(errorMessage);
                }

                const result = await response.json();

                // Handle successful login
                if (result.redirectUrl) {
                    window.location.href = result.redirectUrl || '/';
                } else {
                    window.location.reload();
                }

            } catch (error) {
                // Show error to user
                errorElement.textContent = error.message;
                errorElement.style.display = 'block';

                // Log error for debugging
                console.error('Login error:', error);

            } finally {
                // Restore button state
                button.disabled = false;
                button.innerHTML = originalButtonText;
            }
        });

        function disableForm(form, duration) {
            const elements = form.querySelectorAll('input, button');
            elements.forEach(el => el.disabled = true);

            // Show countdown to user
            const errorElement = document.getElementById('loginError');
            const endTime = Date.now() + duration;

            const countdownInterval = setInterval(() => {
                const remaining = Math.ceil((endTime - Date.now()) / 1000);
                if (remaining <= 0) {
                    clearInterval(countdownInterval);
                    errorElement.textContent = 'Puede intentar nuevamente.';
                    elements.forEach(el => el.disabled = false);
                } else {
                    const minutes = Math.floor(remaining / 60);
                    const seconds = remaining % 60;
                    errorElement.textContent = `Demasiados intentos. Espere ${minutes}:${seconds.toString().padStart(2, '0')} minutos.`;
                }
            }, 1000);
        }

        // Client-side attempt tracking (complementary to server-side)
        (function() {
            const loginAttempts = {};
            const MAX_ATTEMPTS = 5;
            const BLOCK_TIME = 5 * 60 * 1000; // 5 minutes

            document.getElementById('loginForm').addEventListener('submit', function(e) {
                const username = document.getElementById('username').value;
                const now = Date.now();

                // Clear expired blocks
                for (const key in loginAttempts) {
                    if (loginAttempts[key].expiry < now) {
                        delete loginAttempts[key];
                    }
                }

                // Check if user is blocked
                if (loginAttempts[username] && loginAttempts[username].expiry > now) {
                    e.preventDefault();
                    const errorElement = document.getElementById('loginError');
                    const remaining = Math.ceil((loginAttempts[username].expiry - now)/60000);
                    errorElement.textContent = `Demasiados intentos. Espere ${remaining} minutos.`;
                    errorElement.style.display = 'block';
                    return;
                }
            });

            // Track failed attempts (called from the main login function)
            window.trackFailedAttempt = function(username) {
                const now = Date.now();

                if (!loginAttempts[username]) {
                    loginAttempts[username] = { count: 1, expiry: 0 };
                } else {
                    loginAttempts[username].count++;
                }

                // Block if too many attempts
                if (loginAttempts[username].count >= MAX_ATTEMPTS) {
                    loginAttempts[username].expiry = now + BLOCK_TIME;
                }
            };
        })();
    </script>
}