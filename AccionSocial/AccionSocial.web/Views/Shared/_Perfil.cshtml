@using AccionSocialModels.Response
@model CurrentUserResponse?
@{
    ViewData["Title"] = "Perfil";
    Layout = "_LayoutPlantilla";

}


<div class="modal fade" id="perfilModal" tabindex="-1" role="dialog" aria-labelledby="perfilModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="perfilModalLabel">Mi Perfil</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                @if (Model == null)
                {
                    <div class="alert alert-warning">No se pudo cargar la información del perfil</div>
                }
                else
                {
                    <div class="card card-profile">
                        <div class="card-header bg-primary">
                            <div class="profile-picture">
                                <div class="avatar avatar-xl">
                                    <img src="~/assets/img/default-profile.png" alt="Foto de perfil" class="avatar-img rounded-circle">
                                </div>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="user-profile text-center">
                                <div class="name">@Model.NombreCompleto</div>
                                <div class="job">@string.Join(", ", Model.Roles)</div>
                                <div class="desc">
                                    <i class="icon-envelope"></i> <span>@Model.Email</span>
                                </div>
                                <div class="desc">
                                    <i class="icon-user"></i> <span>@Model.UserName</span>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer">
                            <div class="row user-stats text-center">
                                <div class="col">
                                    <div class="title">ID de Usuario</div>
                                    <div class="number small">@Model.UserId</div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

